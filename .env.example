# LlamaCloud API Configuration
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Cohere API Configuration
COHERE_API_KEY=your_cohere_api_key_here

# API Configuration
API_PREFIX=/rag
APP_API_KEY=your_app_api_key_here

# Index Configuration
INDEX_NAMES=docs-1,docs-2,docs-3
PROJECT_NAME=Default

# Retrieval Configuration (accuracy-first; per-index LlamaCloud rerank OFF)
RETRIEVAL_MODE=chunks
DENSE_SIMILARITY_TOP_K=50
SPARSE_SIMILARITY_TOP_K=50
ALPHA=0.35
ENABLE_RERANKING=False
RERANK_TOP_N=30

# Fusion Retriever Configuration
# num_queries=4 → 1 original + 3 LLM paraphrases; similarity_top_k is Cohere pool
FUSION_SIMILARITY_TOP_K=60
FUSION_NUM_QUERIES=4
FUSION_MODE=reciprocal_rerank

# Cohere Rerank Configuration
COHERE_MODEL=rerank-v4.0-pro
COHERE_TOP_N=20
# How many fused docs Cohere sees, and char truncation per doc
COHERE_MAX_DOCS=40
COHERE_DOC_CHARS=1000
COHERE_HTTP_TIMEOUT=45

# OpenAI Configuration
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Workflow Configuration
WORKFLOW_TIMEOUT=180

# Guardrails / ops
MAX_QUERY_LENGTH=2000
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOW_ORIGINS=
# DEBUG=true also mounts /docs, /redoc and /openapi.json
DEBUG=False
# Optional proxy used only for the Cohere rerank call
HTTPS_PROXY=
